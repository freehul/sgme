# SGME Docker 部署密钥模板
# 用法：复制为 docker.env，填入真实值（docker.env 不入 git，见 .gitignore）
# docker compose 经 env_file 自动注入容器

# 鉴权密钥（不设则用 dev 默认 key，仅本机回环；生产/NAS 必设）
SGME_ADMIN_KEY=
SGME_AGENT_KEY=

# LLM 主模型密钥（提炼用，api_key_env 引用，见 config/providers.yaml）
DEEPSEEK_API_KEY=

# 向量 embedding 密钥（三路检索的向量腿，火山方舟）
VOLC_API_KEY=

# 时区（日志/日报/备份定时用本地时区）
TZ=Asia/Shanghai

# skills_hub 远端权威仓（ST-20 env 覆盖；NAS 部署用 file:///git/skills-hub.git，本机开发可留空）
SGME_SKILLS_HUB_REMOTE=

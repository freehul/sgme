#!/bin/sh
# ============================================================
# SGME pre-commit 数据卫生扫描（T-165，2026-09-13）
#
# 提交前第一道机器门禁：扫"暂存区新增行"，命中真实标识/密钥即拒绝提交。
# 部署机制耦合文件（deploy.sh 等 5 个）由 pathspec 排除（待 env 化改造）。
# 豁免：行内 scan-allow 注释；逃生：GIT_COMMIT_SKIP_SCAN=1 git commit …（留痕）
#
# 安装（每份克隆一次）：git config core.hooksPath .githooks
#   或 sh scripts/install_git_hooks.sh
# ============================================================
set -u

# ============================================================
# 第二道：设计决策 ↔ 代码契约对账（2026-11-03 用户定）
#
# 背景：2.0 开发出现 20+ 处「文档写已实现、代码里没有」——只有测试绿这一道闸
# 拦不住"结构性完成、最后一公里没接"（列建了没写入点、表建了没调用方）。
# 规则：改到 sgme/ 下 Python 源码或对账脚本本身时，跑 verify_decisions.py，
#       MISMATCH（文档标已实现但代码不满足）必须为 0 才放行。
# 逃生：GIT_COMMIT_SKIP_DECISION_CHECK=1 git commit …（留痕）
# ============================================================
if [ "${GIT_COMMIT_SKIP_DECISION_CHECK:-}" = "1" ]; then
    echo "[pre-commit] GIT_COMMIT_SKIP_DECISION_CHECK=1 —— 已跳过决策对账（留痕）" >&2
else
    _DEC_CHANGED="$(git diff --cached --name-only | grep -E '^(sgme/.*\.py|scripts/verify_decisions\.py)$' || true)"
    if [ -n "$_DEC_CHANGED" ]; then
        _DEC_ROOT="$(git rev-parse --show-toplevel)"
        _DEC_PY="$_DEC_ROOT/.venv/Scripts/python.exe"
        [ -x "$_DEC_PY" ] || _DEC_PY="python"
        if "$_DEC_PY" "$_DEC_ROOT/scripts/verify_decisions.py" > "$_DEC_ROOT/.git/sgme_decision.log" 2>&1; then
            echo "[pre-commit] 决策对账通过（MISMATCH 0）"
        else
            echo "[pre-commit] ❌ 决策对账失败——文档标已实现但代码不满足：" >&2
            grep -A20 "MISMATCH" "$_DEC_ROOT/.git/sgme_decision.log" | head -30 >&2
            echo "[pre-commit] 处置：补代码 / 把文档状态改回未实现 / 或 GIT_COMMIT_SKIP_DECISION_CHECK=1 留痕跳过" >&2
            exit 1
        fi
    fi
fi

if [ "${GIT_COMMIT_SKIP_SCAN:-}" = "1" ]; then
    echo "[pre-commit] GIT_COMMIT_SKIP_SCAN=1 —— 已跳过数据卫生扫描（留痕）" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
. "$ROOT/.githooks/lib_scan.sh"

DATA="$(mktemp 2>/dev/null || echo "/tmp/sgme_precommit.$$")"
trap 'rm -f "$DATA"' EXIT

git diff --cached --no-color --unified=0 \
    -- . \
    ':(exclude)deploy.sh' \
    ':(exclude)deploy/nas-docker-compose.yml' \
    ':(exclude)scripts/nas_watchdog.sh' \
    ':(exclude)scripts/nas_backup.sh' \
    ':(exclude)scripts/sgme-host-updater.sh' \
    2>/dev/null | grep -a '^+' | grep -av '^+++' > "$DATA" || true

if [ ! -s "$DATA" ]; then
    exit 0
fi

if sgme_scan_file "$DATA"; then
    echo "[pre-commit] 数据卫生扫描通过"
    exit 0
fi
exit 1
